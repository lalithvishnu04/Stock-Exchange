# ─── Application ─────────────────────────────────────────────────
APP_NAME="Stock Market Advisor"
APP_ENV=production
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=231afa4652b707fcf2defae4980b48668be2f1c19013ed1b41d08ba0bc8c249b
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database (SQLite — zero install, file saved in backend/) ───────
DATABASE_URL=sqlite+aiosqlite:///./stock_advisor.db

# ─── Redis (OPTIONAL — leave empty to use built-in memory cache) ──
# Only fill this if you have a Redis server running.
REDIS_URL=
CACHE_TTL_SECONDS=300

# ─── Market Data (FREE – Yahoo Finance, no key needed) ───────────
# No API key required. yfinance fetches NSE/BSE data automatically.

# ─── OpenAI (OPTIONAL – leave blank to use free rule-based AI) ───
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── News API (OPTIONAL FREE – newsapi.org, 100 req/day free) ────
# Register free at https://newsapi.org to get a key
NEWS_API_KEY=

# ─── Telegram Bot (OPTIONAL FREE) ────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy token
# 2. Message @userinfobot on Telegram → copy your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Email SMTP (OPTIONAL FREE – Gmail app password) ─────────────
# Gmail → Security → 2FA → App Passwords → generate
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ─── Portfolio Rules ─────────────────────────────────────────────
MAX_SINGLE_STOCK_ALLOCATION=10
MAX_SINGLE_SECTOR_ALLOCATION=25

# ─── Scheduler (IST times, 24h format) ──────────────────────────
PRE_MARKET_ANALYSIS_TIME=08:00
INTRADAY_INTERVAL_MINUTES=30
POST_MARKET_ANALYSIS_TIME=16:00
DAILY_REPORT_TIME=17:00
WEEKLY_REPORT_DAY=friday

# ─── Frontend ────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
