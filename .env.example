# ─── Application ─────────────────────────────────────────────────
APP_NAME="Stock Market Advisor"
APP_ENV=production
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=231afa4652b707fcf2defae4980b48668be2f1c19013ed1b41d08ba0bc8c249b
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database (SQLite — zero install, file saved in backend/) ───────
DATABASE_URL=sqlite+aiosqlite:///./stock_advisor.db

# ─── Redis (OPTIONAL — leave empty to use built-in memory cache) ──
# Only fill this if you have a Redis server running.
REDIS_URL=
CACHE_TTL_SECONDS=300

# ─── Market Data (FREE – Yahoo Finance, no key needed) ───────────
# No API key required. yfinance fetches NSE/BSE data automatically.

# ─── OpenAI (OPTIONAL – leave blank to use free rule-based AI) ───
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── News API (OPTIONAL FREE – newsapi.org, 100 req/day free) ────
# Register free at https://newsapi.org to get a key
NEWS_API_KEY=

# ─── Telegram Bot (OPTIONAL FREE) ────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy token
# 2. Message @userinfobot on Telegram → copy your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Email SMTP (OPTIONAL FREE – Gmail app password) ─────────────
# Gmail → Security → 2FA → App Passwords → generate
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ─── Portfolio Rules ─────────────────────────────────────────────
MAX_SINGLE_STOCK_ALLOCATION=10
MAX_SINGLE_SECTOR_ALLOCATION=25
# If false (default), stocks you already hold only ever get HOLD/PARTIAL_SELL/SELL —
# never a fresh BUY/ADD_MORE signal, so existing positions are never disturbed.
ALLOW_ADD_MORE_ON_HOLDINGS=false

# ─── Scheduler (IST times, 24h format) ──────────────────────────
PRE_MARKET_ANALYSIS_TIME=08:00
INTRADAY_INTERVAL_MINUTES=30
POST_MARKET_ANALYSIS_TIME=16:00
DAILY_REPORT_TIME=17:00
WEEKLY_REPORT_DAY=friday

# ─── CORS ─────────────────────────────────────────────────────────
# JSON array of origins allowed to call the API. Add your Cloudflare Tunnel
# domain here once you have one (e.g. ["https://stocks.yourdomain.com"]).
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ─── Cloudflare Tunnel (OPTIONAL FREE – access the dashboard from anywhere) ──
# Cloudflare Zero Trust dashboard → Networks → Tunnels → Create a tunnel →
# Docker connector → copy the token (the string after "--token").
CLOUDFLARE_TUNNEL_TOKEN=

# ─── Frontend ────────────────────────────────────────────────────
# Leave these EMPTY so the built frontend calls the API/WebSocket at whatever
# domain it's loaded from (relative path). nginx already proxies /api and /ws
# to the backend, so this works unchanged whether you open the app via
# localhost, your LAN IP, or your Cloudflare Tunnel domain.
VITE_API_BASE_URL=
VITE_WS_URL=
